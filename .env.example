# Backend (local or hosted)
ENVIRONMENT=local
LOG_LEVEL=INFO
BUILD_ID=ax6-local
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional hosted password protection. Set BOTH to enable HTTP Basic Auth.
# Do not commit real credentials.
DEMO_USERNAME=
DEMO_PASSWORD=
# Hosted combined mode serves frontend/dist. Local Vite should leave this unset or 0.
SERVE_FRONTEND=0
PORT=8000
